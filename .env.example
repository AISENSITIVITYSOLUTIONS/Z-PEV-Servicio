# Copiar a .env (no se versiona)
# URL de la Web App de Apps Script (termina en /exec)
VITE_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
# ID de cliente OAuth 2.0 de tipo "Aplicación web"
VITE_GOOGLE_CLIENT_ID=XXXXXXXXXXXX-XXXXXXXX.apps.googleusercontent.com
# Cobro del anticipo con Mercado Pago: integrado pero oculto. Cambiar a true para mostrarlo.
VITE_PAYMENTS_ENABLED=false
# Ruta de la función de cobros (misma URL de Firebase Hosting)
VITE_BILLING_URL=/billing
