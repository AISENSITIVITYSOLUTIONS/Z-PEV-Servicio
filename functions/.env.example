# Copiar a functions/.env (no se versiona). Ver docs/MERCADO_PAGO.md y docs/APLAZO.md
PAYMENTS_ENABLED=false
BILLING_MOCK=true
GOOGLE_CLIENT_ID=XXXXXXXXXXXX-XXXXXXXX.apps.googleusercontent.com
ALLOWED_EMAILS=correo1@dominio.mx,correo2@dominio.mx
PUBLIC_BASE_URL=https://z-pev-servicio.web.app
SHEETS_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
MP_MAX_AMOUNT_MXN=50000
# Aplazo (pago a plazos). Secretos aparte: APLAZO_API_TOKEN y APLAZO_WEBHOOK_TOKEN.
APLAZO_ENABLED=false
APLAZO_ENV=sandbox
APLAZO_MERCHANT_ID=0000
APLAZO_SHOP_ID=z-pev-servicio
APLAZO_MIN_AMOUNT_MXN=100
APLAZO_MAX_AMOUNT_MXN=50000
APLAZO_TTL_HOURS=48
